{
    "name": "wiseadmin/wise-auth",
    "description": "WiseAdmin 通用 RBAC 权限管理包 — 支持多应用、多用户类型、角色继承（RBAC1）与职责分离约束（RBAC2）",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp6",
        "rbac",
        "permission",
        "auth",
        "role",
        "access-control"
    ],
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.5",
        "topthink/framework": "^6.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "wise\\auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\auth\\tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "wise\\auth\\Service"
            ],
            "config": {
                "wise-auth": "config/wise-auth.php"
            },
            "migrate-path": "database/migrations"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/hiwiseadmin/wise-auth",
    "archive": {
        "exclude": [
            "/tests",
            "/docs",
            "/.github",
            "/phpunit.xml",
            "/.gitattributes",
            "/.gitignore",
            "/*.md",
            "!/README.md",
            "/qa/"
        ]
    }
}
