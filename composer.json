{
    "name": "wiseadmin/wise-auth",
    "description": "A universal RBAC permission management package for ThinkPHP6, supporting multi-application, multi-user types, role inheritance (RBAC1), and separation of duty constraints (RBAC2 extension).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp6",
        "rbac",
        "permission",
        "auth",
        "role",
        "access-control"
    ],
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.5",
        "topthink/framework": "^6.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "wise\\auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\auth\\tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "wise\\auth\\Service"
            ],
            "config": {
                "wise-auth": "config/wise-auth.php"
            },
            "migrate-path": "database/migrations"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
