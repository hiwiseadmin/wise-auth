{
    "name": "wiseadmin/wise-auth",
    "description": "WiseAdmin 通用 RBAC 权限管理包 — 支持多应用、多用户类型、角色继承（RBAC1）与职责分离约束（RBAC2）",
    "homepage": "https://github.com/hiwiseadmin/wise-auth",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "thinkphp6",
        "thinkphp8",
        "rbac",
        "permission",
        "auth",
        "role",
        "access-control"
    ],
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "topthink/think-orm": "^3.0",
        "wiseadmin/wise-support": "1.0.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.5",
        "topthink/framework": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "wise\\auth\\": "src/auth/",
            "wise\\login\\": "src/login/"
        },
        "files": [
            "src/login/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\auth\\tests\\": "tests/",
            "wise\\login\\test\\": "tests/login/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "think": {
            "services": [
                "wise\\auth\\AuthServiceProvider",
                "wise\\login\\LoginServiceProvider"
            ],
            "config": {
                "wise-auth": "config/wise-auth.php"
            },
            "publish": {
                "public": "public/statics/plugins/wise-auth"
            }
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/docs",
            "/.github",
            "/phpunit.xml",
            "/.gitattributes",
            "/.gitignore",
            "/*.md",
            "!/README.md",
            "/qa/"
        ]
    }
}
